# ---- سرویس پرداخت: روی سرور تنظیم شود (هرگز commit نشود) ----
PORT=8787
# zarinpal | mock   (mock = درگاه آزمایشی بدون پول)
GATEWAY=zarinpal
# true = sandbox زرین‌پال (برای تست؛ مرچنت‌کد دلخواه ۳۶ کاراکتری می‌پذیرد)
ZARINPAL_SANDBOX=true
# کلید روشن/خاموش کل پرداخت آنلاین سمت سرویس (سمت اپ: Script Property با نام PAYMENTS_ENABLED)
PAYMENTS_ENABLED=true
# آدرس عمومی همین سرویس (https) — درگاه کاربر را به /callback آن برمی‌گرداند
PUBLIC_URL=https://pay.example.ir
# آدرس اپ روی GitHub Pages (بدون اسلش پایانی؛ با زیرمسیر اگر دارد)
SITE_URL=https://USERNAME.github.io/haram-app
# آدرس Web App اپ‌اسکریپت (همان VITE_APPS_SCRIPT_URL)
CONFIRM_URL=https://script.google.com/macros/s/XXXX/exec
# دو رازِ تصادفی ≥۱۶ کاراکتر. SHARED_SECRET باید با Script Property به همین نام در اپ‌اسکریپت یکی باشد.
SHARED_SECRET=
SIGNING_SECRET=
# مرچنت‌کد هر مقصد (هر مقصد حساب/مرچنت جدا = پول مستقیم به حساب همان مقصد).
# کلید: "کارت" یا "کارت/حساب". اول «کارت/حساب» جستجو می‌شود، بعد «کارت».
MERCHANTS_JSON={"hosseiniyeh":"","jihadi":"","mosque":"","multi/civil":"","multi/culture":"","multi/other":""}
MIN_TOMAN=10000
MAX_TOMAN=500000000
# پشت reverse proxy (nginx/لیارا/…) = true
TRUST_PROXY=false
