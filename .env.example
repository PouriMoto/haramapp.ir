# ───────────────────────────────────────────────────────────────
# معمولاً به این فایل نیازی ندارید!
# تنظیمات اصلی (آدرس Apps Script، دامنه، تعداد صفحهٔ اصلی) در data/site.json است.
# این فایل فقط برای «جایگزین موقت» روی کامپیوتر خودتان است (کپی به .env.local).
# هر VITE_* در سایت عمومی می‌شود؛ هرگز رمز نگذارید.
# ───────────────────────────────────────────────────────────────

# جایگزین appsScriptUrl داده/site.json (مثلاً برای تست یک Apps Script دیگر)
# VITE_APPS_SCRIPT_URL=

# فقط برای تست با داده نمایشی با وجود پر بودن appsScriptUrl: mock
# VITE_DATA_PROVIDER=mock

# فقط ابزار مدیریتی خودتان (npm run causes:push) — هرگز در GitHub نگذارید:
# APPS_SCRIPT_URL=
# ADMIN_TOKEN=
